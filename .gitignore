venv/
__pycache__/
*.pyc
.env

# large/intermediate downloads, regenerable via curate_*.py
dataset_generation/commands_dataset/atomic_raw/
dataset_generation/commands_dataset/gtfobins_raw/
dataset_generation/commands_dataset/gtfobins.tar.gz
dataset_generation/commands_dataset/linuxcommands_raw.json

# local-only project context (contains lab credentials)
claude.md

# ml/bundles/ ARE tracked: the trained model bundles (<1 MB total) ship with the
# repo so `git clone` on a deploy VM gets a working model -- api/Dockerfile bakes
# them into the image at build. Do NOT re-ignore them.

# Derivative feature matrices. Regenerable offline by transform.py from the
# session JSONL files, which ARE tracked -- the real telemetry
# (ground_truth/sessions/events/eval_real.jsonl) is the irreplaceable artifact,
# these are just its deterministic downstream. Tracking them meant every
# regeneration showed up as a multi-megabyte diff.
feature_extraction/out/*.SSH.csv
feature_extraction/out/*_kmeans.csv
feature_extraction/out/*_kmeans.json
feature_extraction/out/kmeans_anomalies.json

# Pre-restructure leftovers, referenced by no code (kept on disk, not in git).
feature_extraction/out/features.csv
feature_extraction/out/features_real.csv
feature_extraction/out/features_eval_real_rf.csv

# Empty live-extraction target
feature_extraction/out/live/

# Grafana scored-session store (runtime, rebuilt by the collector)
api/scores.db
api/scores.db-wal
api/scores.db-shm
