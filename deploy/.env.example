# Scenario A deployment config. Copy to `.env` and fill in.
#   cp .env.example .env
# docker compose reads .env automatically from this folder.

# ── Wazuh indexer (the collector pulls sessions from here) ───────────────────
# Must be reachable FROM the VM. Test:  curl -k https://<host>:9200
WAZUH_INDEXER_URL=https://192.168.1.32:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=CHANGE_ME
# Lab certs are self-signed -> false. Set true only with a trusted CA.
WAZUH_VERIFY_TLS=false

# ── collector cadence ────────────────────────────────────────────────────────
# How often to extract + ingest. 30s is a good default.
PAM_INTERVAL=30
# Look-back window each extract cycle. Keep a bit wider than PAM_INTERVAL so a
# slow session close is never missed. 1h is safe (extract dedups by session_id).
EXTRACT_SINCE=1h

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME
# Published port on the VM (browser -> http://<vm-ip>:GF_PORT)
GF_PORT=3000
