# PAM stack config. Copy to `.env` and fill in.  `cp .env.example .env`
# Only ONE value truly changes per machine: WALLIX_HOST (the Bastion VM's IP).
# Everything else uses host.docker.internal, so no other IPs to chase.

# ── The one per-machine IP: the WALLIX Bastion VM (from the VM console) ──────
# Used by feature_extraction/simulate_sessions.py to drive test sessions.
WALLIX_HOST=192.168.1.50

# ── Wazuh indexer (the collector reads sessions from here) ───────────────────
# host.docker.internal = "the Docker host", so this works unchanged on any
# machine as long as the Wazuh stack publishes 9200 on the host (it does).
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=SecretPassword
WAZUH_VERIFY_TLS=false

# ── collector cadence ────────────────────────────────────────────────────────
PAM_INTERVAL=30          # extract+ingest every N seconds
EXTRACT_SINCE=1h         # look-back window per cycle (keep > PAM_INTERVAL)

# ── Grafana ──────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
GF_PORT=3000             # set 3001 if you already run Grafana on 3000
