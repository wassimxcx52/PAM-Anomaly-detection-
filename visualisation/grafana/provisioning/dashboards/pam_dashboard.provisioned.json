{
  "title": "PAM Anomaly Scores",
  "uid": "pam-anomaly",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ],
    "time_options": [
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "tags": [
    "pam",
    "wallix",
    "anomaly",
    "insider-threat"
  ],
  "templating": {
    "list": [
      {
        "name": "identity",
        "label": "User / identity",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "infinity-pam"
        },
        "includeAll": true,
        "allValue": "All",
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "url",
            "format": "table",
            "url": "http://pam-scoring:8000/grafana/vars/identities?from=${__from}&to=${__to}",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ]
          }
        }
      },
      {
        "name": "session",
        "label": "Session (drill-down)",
        "type": "query",
        "datasource": {
          "type": "yesoreyeram-infinity-datasource",
          "uid": "infinity-pam"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 0,
        "query": {
          "queryType": "infinity",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "url",
            "format": "table",
            "url": "http://pam-scoring:8000/grafana/vars/sessions?from=${__from}&to=${__to}&identity=${identity}",
            "url_options": {
              "method": "GET",
              "data": ""
            },
            "root_selector": "",
            "columns": [
              {
                "selector": "__text",
                "text": "__text",
                "type": "string"
              },
              {
                "selector": "__value",
                "text": "__value",
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  },
