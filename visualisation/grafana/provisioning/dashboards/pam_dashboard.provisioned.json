    {
      "id": 9,
      "title": "Session command audit log  \u00c2\u00b7  ${session}",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity-pam"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              },
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seq"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "surprisal"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "text"
                    },
                    {
                      "value": 12,
                      "color": "orange"
                    },
                    {
                      "value": 16,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "risk_flag"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "cred_access": {
                        "color": "red",
                        "index": 0
                      },
                      "privesc": {
                        "color": "red",
                        "index": 1
                      },
                      "log_tamper": {
                        "color": "red",
                        "index": 2
                      },
                      "exfil": {
                        "color": "red",
                        "index": 3
                      },
                      "persistence": {
                        "color": "orange",
                        "index": 4
                      },
                      "recon": {
                        "color": "yellow",
                        "index": 5
                      },
                      "-": {
                        "color": "transparent",
                        "index": 6
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "seq",
            "desc": false
          }
        ],
        "cellHeight": "sm"
      },
      "targets": [
