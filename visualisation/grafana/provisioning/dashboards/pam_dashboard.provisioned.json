    {
      "id": 6,
      "title": "Ranked anomaly scores  (click a bar to inspect)",
      "type": "barchart",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity-pam"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              },
              {
                "value": 0.664,
                "color": "red"
              }
            ]
          },
          "links": [
            {
              "title": "Inspect this session",
              "url": "/d/${__dashboard.uid}/${__dashboard.slug}?var-session=${__data.fields.session_id}&${identity:queryparam}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "barWidth": 0.8,
        "fullHighlight": false,
        "xField": "label",
        "colorByField": "score"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity-pam"
          },
          "url": "http://pam-scoring:8000/grafana/ranked?from=${__from}&to=${__to}&identity=${identity}&limit=50",
